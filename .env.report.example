# Copy these placeholders to a protected file outside the repository.
# The reporting identity must have SELECT on the Reqsheet database and no write privileges.
REPORT_DB_HOST=127.0.0.1
REPORT_DB_PORT=3306
REPORT_DB_NAME=reqsheet_dev
REPORT_DB_USER=reqsheet_monitor
REPORT_DB_PASSWORD=replace-with-a-strong-reporting-password
REPORT_ENVIRONMENT=Pumba development
REPORT_TIMEZONE=Europe/London
